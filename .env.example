# ---------- Banco de dados ----------
POSTGRES_USER=tiescolar
POSTGRES_PASSWORD=tiescolar
POSTGRES_DB=tiescolar
# DSN usado pelo backend (host "db" é o serviço do docker-compose)
DATABASE_URL=postgresql+psycopg://tiescolar:tiescolar@db:5432/tiescolar

# ---------- LLM ----------
# Provedor de geração: "fake" (sem chave, para demo) | "anthropic" | "openai"
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Provedor de embeddings: "fake" (determinístico, sem chave) | "openai"
#
# ATENÇÃO ao plural. O campo é `embeddings_provider`, então a variável é EMBEDDINGS_ e não
# EMBEDDING_. Até 17/ago/2026 este arquivo dizia `EMBEDDING_PROVIDER`, que com
# `extra="ignore"` no pydantic-settings era aceito e DESCARTADO: quem copiasse o exemplo e
# trocasse para "openai" seguia no embedder falso, e o RAG respondia citando fonte sem ter
# recuperado nada. Falha silenciosa, do tipo que só aparece na resposta errada ao pai.
# `EMBEDDING_DIM` (singular) está certo — esse campo é mesmo `embedding_dim`.
EMBEDDINGS_PROVIDER=fake
EMBEDDING_DIM=1536
# Só com EMBEDDINGS_PROVIDER=openai. Sem chave, o adaptador não sobe.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1

# ---------- Seed de demonstração ----------
# Cria a Escola Demonstração (alunos, fichas, logins de exemplo). NUNCA em produção:
# o seed é bloqueado quando APP_ENV=production, mesmo com esta flag ligada. Fora de
# desenvolvimento, também exige que as senhas abaixo tenham valores próprios.
SEED_DEMO=true

# ---------- Administração ----------
# Super admin da plataforma (seu controle, cross-tenant). Criado pelo `app.bootstrap`,
# que roda em TODO deploy — inclusive produção — e é idempotente: se o e-mail já existe,
# a senha NÃO é sobrescrita. Em produção o bootstrap recusa a senha de exemplo abaixo.
SUPER_ADMIN_EMAIL=admin@tiescolar.test
SUPER_ADMIN_SENHA=troque-esta-senha
SUPER_ADMIN_NOME=Super Admin
# Admin do tenant de demonstração (Escola Demonstração)
DEMO_ADMIN_EMAIL=admin@escola-demo.test
DEMO_ADMIN_SENHA=escola123
# Senha do professor demo (login do mural do professor — §A1)
DEMO_PROFESSOR_SENHA=prof123

# ---------- Observabilidade / logs ----------
# Nível do logger raiz (DEBUG | INFO | WARNING | ERROR).
LOG_NIVEL=INFO
# Log do console em JSON (para um coletor externo ler o stdout). Formato legível se false.
LOG_JSON=false
# Persistir os logs no Postgres, alimentando o painel /admin/logs (só super admin).
LOG_PERSISTIR=true
# Nível mínimo que vai para o banco. WARNING reduz muito o volume, ao custo de perder o
# rastro das requisições bem-sucedidas (e, com ele, a medição de latência).
LOG_NIVEL_PERSISTIDO=INFO
# Teto da fila em memória. Cheia, descarta o registro mais antigo — nunca bloqueia a
# resposta ao usuário para conseguir gravar log.
LOG_FILA_CAPACIDADE=2000
# Dias de retenção; a limpeza roda a cada 6h no próprio processo.
LOG_RETENCAO_DIAS=14

# ---------- Limite de taxa de entrada ----------
# Contador de janela fixa no Postgres (tabela controle_taxa): vale para todas as réplicas
# e sobrevive a restart. Desligue apenas para depurar.
RATE_LIMIT_HABILITADO=true
# Login (/api/admin/login e /api/professor/login): tentativas por janela, contadas por IP
# E por identificador (e-mail/telefone). Excedente recebe 429 com Retry-After.
RATE_LIMIT_LOGIN_TENTATIVAS=10
RATE_LIMIT_LOGIN_JANELA_SEGUNDOS=300
# Inbound do webhook: mensagens por remetente por janela. A excedente é descartada antes
# de acionar a LLM (o webhook segue devolvendo 200 à Meta). 0 desliga.
RATE_LIMIT_INBOUND_MENSAGENS=20
RATE_LIMIT_INBOUND_JANELA_SEGUNDOS=60
# Confiar no X-Forwarded-For para identificar o IP do cliente. true atrás do proxy do
# Render; false se a API for exposta direto (o cabeçalho é forjável pelo cliente).
TRUST_PROXY_HEADERS=true

# ---------- Autenticação (JWT) ----------
# Segredo de assinatura HS256 do token do painel — TROQUE por um valor forte em produção.
JWT_SECRET=troque-este-segredo-jwt
# Validade do token em minutos (480 = 8 horas)
JWT_EXPIRA_MINUTOS=480

# ---------- Canal de mensagens ----------
# "demo" = registra os envios em memória (desenvolvimento local, sem token da Meta).
# "meta" = WhatsApp de verdade — e EXIGE META_ACCESS_TOKEN: sem o token a fábrica cai no
# canal demo SEM ERRO NENHUM e nada chega ao WhatsApp (veja /health, campo "canal").
MESSAGE_CHANNEL=demo

# ---------- Meta WhatsApp Cloud API (inbound + outbound) ----------
# Número remetente PADRÃO (fallback). Cada escola tem o seu próprio phone_number_id
# (Tenant.meta_phone_number_id); este é usado quando a escola não tem um cadastrado.
META_PHONE_NUMBER_ID=
# Não há META_WABA_ID: a conta do WhatsApp Business (WABA) é cadastro, não configuração.
# Ela mora no banco e é escolhida por escola — uma variável de ambiente não comporta a
# segunda conta, e o teto de números do portfólio garante que ela vai existir. O id é
# preenchido em Administração → Contas WhatsApp, ou reconhecido sozinho no primeiro evento
# do webhook (confirmado contra a Graph API antes de ser gravado).
# Token de USUÁRIO DO SISTEMA (Business Manager > Usuários do sistema), com as permissões
# whatsapp_business_messaging e whatsapp_business_management. O token da tela de
# "Configuração da API" expira em 24h e NÃO serve para produção.
META_ACCESS_TOKEN=
# Token do handshake GET do webhook (hub.verify_token). TROQUE por um valor forte.
META_WEBHOOK_VERIFY_TOKEN=changeme
# Destinatários únicos por 24h que podemos iniciar conversa. É medido pela Meta NO
# PORTFÓLIO e compartilhado por todos os números dele — não por número. Portfólio novo
# começa em 250; sobe para 2.000 com a empresa verificada e depois um nível a cada 6h.
# Configure o valor REAL: acima dele o excedente vira falha, que derruba a qualidade do
# número e trava a subida do limite. -1 = ilimitado.
META_DAILY_TIER_LIMIT=250
# App secret (Meta for Developers > Configurações > Básico) — chave do HMAC que valida a
# assinatura X-Hub-Signature-256 dos webhooks.
META_APP_SECRET=
# Valida a assinatura dos webhooks: true | false. OBRIGATÓRIO true em produção — sem isso
# qualquer um pode forjar status de entrega e mensagens recebidas no endpoint público.
META_VALIDATE_SIGNATURE=false

# ---------- Retomada de disparos travados pela cota (§9a-quinquies) ----------
# Uma escola grande não cabe numa janela de 24h, então o excedente fica PENDENTE e uma
# tarefa de fundo volta para concluí-lo. Ela segue uma GRADE, não um intervalo: 3 passadas
# entre 7h e 18h, de segunda a sexta.
#
# Por que grade. Com intervalo fixo de 30 min eram 48 passadas por dia, todos os dias, cada
# uma abrindo sessão mesmo sem nada a fazer — o que mantém o Postgres serverless acordado
# 24/7 (custo) e pode disparar aviso escolar às 3h da manhã, no dia em que a cota liberar
# de madrugada (pior).
#
# Nenhuma delas precisa ser preenchida: os defaults abaixo já são os valores em uso.
# BROADCAST_RETOMADA_HABILITADA=true
# BROADCAST_RETOMADA_PASSADAS=3
# BROADCAST_RETOMADA_INICIO=07:00
# BROADCAST_RETOMADA_FIM=18:00
# ISO: 1 = segunda … 7 = domingo. Lixo no meio é ignorado; nada válido volta a seg–sex.
# BROADCAST_RETOMADA_DIAS=1,2,3,4,5
# BROADCAST_RETOMADA_TIMEZONE=America/Sao_Paulo
# Prazo de VALIDADE do disparo, não otimização: aviso de três semanas atrás entregue hoje é
# pior que não entregue. Cobre com folga o maior buraco da grade (sexta 18h → segunda 7h).
# BROADCAST_RETOMADA_JANELA_DIAS=7

# ---------- Atendimento humano (§6j) ----------
# Nome do template usado para reabrir uma conversa cuja janela de 24h expirou (o
# responsável escreveu à noite e a secretaria só viu no dia seguinte).
#
# NÃO precisa mexer: o default já é `retomada_atendimento`. Quem garante que a mensagem só
# sai com template aprovado é o STATUS do template no catálogo (§9a-bis), que vem da Meta
# pelo webhook ou pela sincronização — não esta variável.
#
# Deixe-a AUSENTE (e não vazia): vazio DESLIGA a retomada, e aí conversa com mais de 24h
# não pode ser respondida. Preencha só para apontar outro nome de template.
# TEMPLATE_RETOMADA_ATENDIMENTO=retomada_atendimento

# ---------- Documentos recebidos dos responsáveis (§6k) ----------
# Retenção dos arquivos que os pais enviam pelo WhatsApp (atestado, RG, comprovante).
# É dado sensível de menor — atestado é dado de saúde —, então o prazo não é opcional:
# 365 dias cobrem o ciclo letivo em que o documento foi entregue. 0 desliga o expurgo, e o
# painel de segurança passa a acusar isso como ATENÇÃO.
DOCUMENTO_RETENCAO_DIAS=365

# ---------- Alerta ativo de falha (§15, item 8) ----------
# Sentry. VAZIO = desligado, e é o default: sem DSN não há subprocessador novo e o produto
# funciona igual — só não avisa ninguém de um erro.
#
# ⚠️ Ligar isto ACRESCENTA UM OPERADOR nos EUA ao tratamento. O evento de erro é limpo antes
# de sair (send_default_pii=False + before_send removendo telefone, CPF, laudo, nome e
# segredo, e descartando o evento inteiro se a limpeza falhar), mas a decisão de contratar o
# subprocessador é de negócio, não de configuração — e a política de privacidade precisa
# refleti-la. Ver app/infrastructure/observabilidade.py.
SENTRY_DSN=
# Separa produção de homolog no painel do Sentry. Vazio = usa o APP_ENV.
SENTRY_ENVIRONMENT=
# Trace de performance. 0 de propósito: o que se quer aqui é o alerta de ERRO, e transação
# é o que consome a franquia do plano free (5 mil erros/mês) depressa.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------- Armazenamento dos arquivos recebidos (§6k) ----------
# Onde ficam os BYTES dos arquivos que os pais mandam. Os metadados ficam sempre no
# Postgres. "postgres" (bytea, sem infra nova) | "s3".
#
# ⚠️ ARQUIVO_STORAGE=s3 SEM S3_BUCKET_DOCUMENTOS **cai no Postgres**. O log de boot e o
# /health acusam (campo "storage"), porque é a mesma armadilha do MESSAGE_CHANNEL=meta sem
# token: a env pede um adaptador, o processo usa outro, e o único sintoma seria atestado de
# menor engordando um banco cobrado por GB.
ARQUIVO_STORAGE=postgres
# Região do bucket. sa-east-1 (São Paulo) é a decisão registrada: guardar atestado médico de
# criança fora do Brasil é transferência internacional (LGPD arts. 33-36) e exigiria base
# legal, cláusula contratual e declaração na política de privacidade.
AWS_REGION=sa-east-1
# Buckets separados por ambiente — um acidente em homolog não pode tocar produção.
S3_BUCKET_DOCUMENTOS=
# Credenciais de um usuário IAM dedicado, com política restrita a Put/Get/Delete/List no ARN
# deste bucket. Nada de s3:*. Deixe VAZIAS em EC2/ECS: o boto3 usa a role da instância, que
# é mais seguro que chave.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# CMK do KMS usada na criptografia em repouso (SSE-KMS). Dá auditoria por objeto no CloudTrail
# e permite destruir a chave se um dia for preciso inutilizar o acervo. Vazio = SSE-S3, que
# ainda é criptografia em repouso, só que sem chave nossa.
S3_KMS_KEY_ID=
# Endpoint alternativo — só para o MinIO local/CI, que é S3-compatível. VAZIO em produção,
# senão o boto3 fala com o lugar errado. Com o docker-compose: http://localhost:9000
S3_ENDPOINT_URL=
#
# ⚠️ **Ao criar o bucket, confira o versionamento.** Ligado e sem regra de expiração de
# versões não-correntes, o DeleteObject do expurgo NÃO apaga nada: cria um delete marker e
# os bytes do atestado seguem no bucket. O expurgo relataria sucesso e a retenção pareceria
# em dia. Ver docs/plano-correcoes-teste-10-08.md §0.4 para a configuração completa
# (Block Public Access, BucketOwnerEnforced, Deny sem TLS, lifecycle).

# ---------- Licenciamento / avisos por e-mail ----------
# Janela (em dias) para avisar que a licença anual está perto de vencer.
LICENSE_WARNING_DAYS=30
# Provedor de e-mail: "log" (mock — só registra no log) | "resend" (envio real).
# Com "resend" e RESEND_API_KEY vazia, cai automaticamente no adaptador de log: o deploy
# não quebra, mas o painel de segurança sinaliza que nenhum e-mail está saindo.
EMAIL_PROVIDER=log
# Chave da API do resend.com (Dashboard > API Keys). Deixe em branco até criar a sua.
RESEND_API_KEY=
# Remetente dos e-mails administrativos. Com o Resend, o domínio precisa estar verificado
# lá (SPF/DKIM), senão o envio é recusado.
EMAIL_FROM=no-reply@tiescolar.com.br

# ---------- App ----------
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000
