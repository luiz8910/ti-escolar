# ---------- Banco de dados ----------
POSTGRES_USER=tiescolar
POSTGRES_PASSWORD=tiescolar
POSTGRES_DB=tiescolar
# DSN usado pelo backend (host "db" é o serviço do docker-compose)
DATABASE_URL=postgresql+psycopg://tiescolar:tiescolar@db:5432/tiescolar

# ---------- LLM ----------
# Provedor de geração: "fake" (sem chave, para demo) | "anthropic" | "openai"
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Provedor de embeddings: "fake" (determinístico, sem chave) | "openai"
EMBEDDING_PROVIDER=fake
EMBEDDING_DIM=1536

# ---------- Seed de demonstração ----------
# Cria a Escola Demonstração (alunos, fichas, logins de exemplo). NUNCA em produção:
# o seed é bloqueado quando APP_ENV=production, mesmo com esta flag ligada. Fora de
# desenvolvimento, também exige que as senhas abaixo tenham valores próprios.
SEED_DEMO=true

# ---------- Administração ----------
# Super admin da plataforma (seu controle, cross-tenant). Criado pelo `app.bootstrap`,
# que roda em TODO deploy — inclusive produção — e é idempotente: se o e-mail já existe,
# a senha NÃO é sobrescrita. Em produção o bootstrap recusa a senha de exemplo abaixo.
SUPER_ADMIN_EMAIL=admin@tiescolar.test
SUPER_ADMIN_SENHA=troque-esta-senha
SUPER_ADMIN_NOME=Super Admin
# Admin do tenant de demonstração (Escola Demonstração)
DEMO_ADMIN_EMAIL=admin@escola-demo.test
DEMO_ADMIN_SENHA=escola123
# Senha do professor demo (login do mural do professor — §A1)
DEMO_PROFESSOR_SENHA=prof123

# ---------- Observabilidade / logs ----------
# Nível do logger raiz (DEBUG | INFO | WARNING | ERROR).
LOG_NIVEL=INFO
# Log do console em JSON (para um coletor externo ler o stdout). Formato legível se false.
LOG_JSON=false
# Persistir os logs no Postgres, alimentando o painel /admin/logs (só super admin).
LOG_PERSISTIR=true
# Nível mínimo que vai para o banco. WARNING reduz muito o volume, ao custo de perder o
# rastro das requisições bem-sucedidas (e, com ele, a medição de latência).
LOG_NIVEL_PERSISTIDO=INFO
# Teto da fila em memória. Cheia, descarta o registro mais antigo — nunca bloqueia a
# resposta ao usuário para conseguir gravar log.
LOG_FILA_CAPACIDADE=2000
# Dias de retenção; a limpeza roda a cada 6h no próprio processo.
LOG_RETENCAO_DIAS=14

# ---------- Limite de taxa de entrada ----------
# Contador de janela fixa no Postgres (tabela controle_taxa): vale para todas as réplicas
# e sobrevive a restart. Desligue apenas para depurar.
RATE_LIMIT_HABILITADO=true
# Login (/api/admin/login e /api/professor/login): tentativas por janela, contadas por IP
# E por identificador (e-mail/telefone). Excedente recebe 429 com Retry-After.
RATE_LIMIT_LOGIN_TENTATIVAS=10
RATE_LIMIT_LOGIN_JANELA_SEGUNDOS=300
# Inbound do webhook: mensagens por remetente por janela. A excedente é descartada antes
# de acionar a LLM (o webhook segue devolvendo 200 à Meta). 0 desliga.
RATE_LIMIT_INBOUND_MENSAGENS=20
RATE_LIMIT_INBOUND_JANELA_SEGUNDOS=60
# Confiar no X-Forwarded-For para identificar o IP do cliente. true atrás do proxy do
# Render; false se a API for exposta direto (o cabeçalho é forjável pelo cliente).
TRUST_PROXY_HEADERS=true

# ---------- Autenticação (JWT) ----------
# Segredo de assinatura HS256 do token do painel — TROQUE por um valor forte em produção.
JWT_SECRET=troque-este-segredo-jwt
# Validade do token em minutos (480 = 8 horas)
JWT_EXPIRA_MINUTOS=480

# ---------- Canal de mensagens ----------
# "demo" = registra os envios em memória (desenvolvimento local, sem token da Meta).
# "meta" = WhatsApp de verdade — e EXIGE META_ACCESS_TOKEN: sem o token a fábrica cai no
# canal demo SEM ERRO NENHUM e nada chega ao WhatsApp (veja /health, campo "canal").
MESSAGE_CHANNEL=demo

# ---------- Meta WhatsApp Cloud API (inbound + outbound) ----------
# Número remetente PADRÃO (fallback). Cada escola tem o seu próprio phone_number_id
# (Tenant.meta_phone_number_id); este é usado quando a escola não tem um cadastrado.
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Token de USUÁRIO DO SISTEMA (Business Manager > Usuários do sistema), com as permissões
# whatsapp_business_messaging e whatsapp_business_management. O token da tela de
# "Configuração da API" expira em 24h e NÃO serve para produção.
META_ACCESS_TOKEN=
# Token do handshake GET do webhook (hub.verify_token). TROQUE por um valor forte.
META_WEBHOOK_VERIFY_TOKEN=changeme
# Limite diário de destinatários únicos por número (tier Meta): 1000 | 10000 | 100000 | -1 (ilimitado)
META_DAILY_TIER_LIMIT=1000
# App secret (Meta for Developers > Configurações > Básico) — chave do HMAC que valida a
# assinatura X-Hub-Signature-256 dos webhooks.
META_APP_SECRET=
# Valida a assinatura dos webhooks: true | false. OBRIGATÓRIO true em produção — sem isso
# qualquer um pode forjar status de entrega e mensagens recebidas no endpoint público.
META_VALIDATE_SIGNATURE=false

# ---------- Licenciamento / avisos por e-mail ----------
# Janela (em dias) para avisar que a licença anual está perto de vencer.
LICENSE_WARNING_DAYS=30
# Provedor de e-mail: "log" (mock — só registra no log) | "resend" (envio real).
# Com "resend" e RESEND_API_KEY vazia, cai automaticamente no adaptador de log: o deploy
# não quebra, mas o painel de segurança sinaliza que nenhum e-mail está saindo.
EMAIL_PROVIDER=log
# Chave da API do resend.com (Dashboard > API Keys). Deixe em branco até criar a sua.
RESEND_API_KEY=
# Remetente dos e-mails administrativos. Com o Resend, o domínio precisa estar verificado
# lá (SPF/DKIM), senão o envio é recusado.
EMAIL_FROM=no-reply@tiescolar.com.br

# ---------- App ----------
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000
