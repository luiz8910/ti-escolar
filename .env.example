# ---------- Banco de dados ----------
POSTGRES_USER=tiescolar
POSTGRES_PASSWORD=tiescolar
POSTGRES_DB=tiescolar
# DSN usado pelo backend (host "db" é o serviço do docker-compose)
DATABASE_URL=postgresql+psycopg://tiescolar:tiescolar@db:5432/tiescolar

# ---------- LLM ----------
# Provedor de geração: "fake" (sem chave, para demo) | "anthropic" | "openai"
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Provedor de embeddings: "fake" (determinístico, sem chave) | "openai"
EMBEDDING_PROVIDER=fake
EMBEDDING_DIM=1536

# ---------- Administração (criados no seed) ----------
# Super admin da plataforma (seu controle, cross-tenant)
SUPER_ADMIN_EMAIL=admin@tiescolar.test
SUPER_ADMIN_SENHA=troque-esta-senha
SUPER_ADMIN_NOME=Super Admin
# Admin do tenant de demonstração (Escola Demonstração)
DEMO_ADMIN_EMAIL=admin@escola-demo.test
DEMO_ADMIN_SENHA=escola123
# Senha do professor demo (login do mural do professor — §A1)
DEMO_PROFESSOR_SENHA=prof123

# ---------- Autenticação (JWT) ----------
# Segredo de assinatura HS256 do token do painel — TROQUE por um valor forte em produção.
JWT_SECRET=troque-este-segredo-jwt
# Validade do token em minutos (480 = 8 horas)
JWT_EXPIRA_MINUTOS=480

# ---------- Chat de demonstração (simulador do WhatsApp) ----------
# O demo é público (sem login) e grava conversa real + consome LLM do tenant informado.
# Por isso fica preso ao tenant de vitrine; aponte-o para uma escola real e você polui o
# histórico dela de graça. Em produção, considere CHAT_DEMO_HABILITADO=false.
CHAT_DEMO_HABILITADO=true
CHAT_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001

# ---------- Canal de mensagens ----------
# Canal padrão de saída: "demo" (in-memory/WS) | "meta"
MESSAGE_CHANNEL=demo

# ---------- Meta WhatsApp Cloud API (inbound + outbound) ----------
# Número remetente PADRÃO (fallback). Cada escola tem o seu próprio phone_number_id
# (Tenant.meta_phone_number_id); este é usado quando a escola não tem um cadastrado.
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Token de USUÁRIO DO SISTEMA (Business Manager > Usuários do sistema), com as permissões
# whatsapp_business_messaging e whatsapp_business_management. O token da tela de
# "Configuração da API" expira em 24h e NÃO serve para produção.
META_ACCESS_TOKEN=
# Token do handshake GET do webhook (hub.verify_token). TROQUE por um valor forte.
META_WEBHOOK_VERIFY_TOKEN=changeme
# Limite diário de destinatários únicos por número (tier Meta): 1000 | 10000 | 100000 | -1 (ilimitado)
META_DAILY_TIER_LIMIT=1000
# App secret (Meta for Developers > Configurações > Básico) — chave do HMAC que valida a
# assinatura X-Hub-Signature-256 dos webhooks.
META_APP_SECRET=
# Valida a assinatura dos webhooks: true | false. OBRIGATÓRIO true em produção — sem isso
# qualquer um pode forjar status de entrega e mensagens recebidas no endpoint público.
META_VALIDATE_SIGNATURE=false

# ---------- Licenciamento / avisos por e-mail ----------
# Janela (em dias) para avisar que a licença anual está perto de vencer.
LICENSE_WARNING_DAYS=30
# Remetente dos e-mails administrativos (o adaptador atual é mock/log).
EMAIL_FROM=no-reply@tiescolar.test

# ---------- App ----------
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000
